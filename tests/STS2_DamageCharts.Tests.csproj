<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <!-- CI/dev machines may only have the .NET 10 runtime installed; roll the net9.0 test host forward. -->
    <RollForward>Major</RollForward>
    <Nullable>enable</Nullable>
    <LangVersion>12.0</LangVersion>
    <IsPackable>false</IsPackable>
    <RootNamespace>STS2_DamageCharts.Tests</RootNamespace>
  </PropertyGroup>

  <!-- Compile the pure sources directly (they have no Godot/game refs), so tests need no game DLLs. -->
  <ItemGroup>
    <Compile Include="../Forecast/DamageForecast.cs" Link="DamageForecast.cs" />
    <Compile Include="../Tracking/DamageTracker.cs" Link="DamageTracker.cs" />
    <Compile Include="../Tracking/RunAggregate.cs" Link="RunAggregate.cs" />
    <Compile Include="../Tracking/GroupDetail.cs" Link="GroupDetail.cs" />
    <Compile Include="../Forecast/SelfHarmText.cs" Link="SelfHarmText.cs" />
    <Compile Include="../Overlay/OverlayTransform.cs" Link="OverlayTransform.cs" />
    <Compile Include="../Forecast/IntentRules.cs" Link="IntentRules.cs" />
    <Compile Include="../Stats/RunId.cs" Link="RunId.cs" />
    <Compile Include="../Stats/RunStatsFile.cs" Link="RunStatsFile.cs" />
    <Compile Include="../Share/AppStatus.cs" Link="AppStatus.cs" />
    <Compile Include="../Share/ShareAction.cs" Link="ShareAction.cs" />
    <Compile Include="../Share/ShareLayout.cs" Link="ShareLayout.cs" />
    <Compile Include="../Ui/CardPortrait.cs" Link="CardPortrait.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>
</Project>
